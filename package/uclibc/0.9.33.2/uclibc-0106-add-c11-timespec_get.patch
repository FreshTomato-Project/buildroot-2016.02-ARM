diff -ruN a/libc/misc/time/timespec_get.c b/libc/misc/time/timespec_get.c
--- a/libc/misc/time/timespec_get.c	1970-01-01 00:00:00.000000000 +0000
+++ b/libc/misc/time/timespec_get.c	2026-09-10 10:47:00.533053528 +0000
@@ -0,0 +1,25 @@
+/*
+ * C11 timespec_get().
+ *
+ * Licensed under the LGPL v2.1 or later.
+ */
+
+#include <time.h>
+#include <sys/time.h>
+
+int
+timespec_get(struct timespec *ts, int base)
+{
+    struct timeval tv;
+
+    if (base != TIME_UTC)
+        return 0;
+
+    if (gettimeofday(&tv, NULL) != 0)
+        return 0;
+
+    ts->tv_sec = tv.tv_sec;
+    ts->tv_nsec = tv.tv_usec * 1000L;
+
+    return base;
+}
