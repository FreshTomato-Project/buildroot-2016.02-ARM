diff -ruN a/include/time.h b/include/time.h
--- a/include/time.h	2012-05-15 07:20:09.000000000 +0000
+++ b/include/time.h	2026-09-10 10:47:00.532891574 +0000
@@ -110,7 +110,7 @@
 
 #if !defined __timespec_defined &&				\
     ((defined _TIME_H &&					\
-      (defined __USE_POSIX199309 || defined __USE_MISC)) ||	\
+      (defined __USE_POSIX199309 || defined __USE_MISC || defined __USE_ISOC11)) ||	\
       defined __need_timespec)
 # define __timespec_defined	1
 
@@ -189,6 +189,14 @@
 extern time_t time (time_t *__timer) __THROW;
 libc_hidden_proto(time)
 
+#ifdef __USE_ISOC11
+/* Time base for timespec_get.  */
+# define TIME_UTC 1
+
+/* Set TS to the current calendar time based on BASE.  */
+extern int timespec_get (struct timespec *__ts, int __base) __THROW;
+#endif
+
 #ifdef __UCLIBC_HAS_FLOATS__
 /* Return the difference between TIME1 and TIME0.  */
