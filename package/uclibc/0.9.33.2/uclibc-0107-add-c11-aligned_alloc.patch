diff -ruN a/libc/stdlib/aligned_alloc.c b/libc/stdlib/aligned_alloc.c
--- a/libc/stdlib/aligned_alloc.c	1970-01-01 00:00:00.000000000 +0000
+++ b/libc/stdlib/aligned_alloc.c	2026-09-10 12:34:45.232435892 +0000
@@ -0,0 +1,27 @@
+/*
+ * C11 aligned_alloc().
+ *
+ * Licensed under the LGPL v2.1 or later.
+ */
+
+#include <stdlib.h>
+#include <malloc.h>
+#include <errno.h>
+
+void *
+aligned_alloc(size_t alignment, size_t size)
+{
+    /* Keep the supported alignment rules consistent with posix_memalign().
+     * C11 additionally requires SIZE to be an integral multiple of ALIGNMENT.
+     */
+    if (alignment == 0
+        || (alignment & (alignment - 1)) != 0
+        || alignment % sizeof(void *) != 0
+        || size % alignment != 0)
+    {
+        errno = EINVAL;
+        return NULL;
+    }
+
+    return memalign(alignment, size);
+}
